# Copy to .env and fill in real values. .env is gitignored: never commit it.

# --- Secrets (placeholders only) ---
OPENAI_API_KEY=your-key-here
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# A long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# --- Settings ---
TOKEN_TTL_SECONDS=3600
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=clinic_docs
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# --- MCP servers (Docker service names on clinic_net) ---
APPOINTMENTS_MCP_URL=http://appointments:8001/mcp
PHARMACY_MCP_URL=http://pharmacy:8002/mcp
RECORDS_MCP_URL=http://records:8003/mcp
KNOWLEDGE_MCP_URL=http://knowledge:8004/mcp
