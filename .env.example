# Copy to .env and fill in OPENAI_API_KEY. Every other value has a safe default.
# Never commit .env.

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=20

# --- PostgreSQL (the `db` service) ---
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic

# --- API ---
API_PORT=8000
