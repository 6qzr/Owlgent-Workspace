# Copy to .env and fill in OPENAI_API_KEY (or set LLM_PROVIDER=fake). Every other value has a safe default.
# Never commit .env.
# --- LLM ---
# openai (needs OPENAI_API_KEY) or fake (rule-based demo, no key needed)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=20

# --- PostgreSQL ---
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000